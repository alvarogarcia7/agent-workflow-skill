# Copy to .agent-workflow.env in the MAIN checkout of your repository (it is found from every git worktree through the
# git common dir) or point AGENT_WORKFLOW_ENV at it with an ABSOLUTE path. Do not commit it. This file is sourced by
# bash, so it is code: only keep trusted content in it.
STATE_DIR="$HOME/.local/state/agent-workflow"   # shared by all agents on the machine (locks, ci-status.json, logs, queue)
REMOTE=origin
BRANCH=                                          # REQUIRED for safe-push.sh: the shared integration branch agents push to
PUSH_OPTS="-o ci.skip"                           # GitLab: no pipeline on push. Set "" for remotes without push options (GitHub)
#POST_REBASE_CHECK="npm run lint"                # optional quick check after a rebase, before the push
HEAVY_SLOTS=2                                    # max concurrent heavy jobs on this machine (positive integer)
GITLAB_PROJECT="my-group%2Fmy-repo"              # url-encoded namespace/project (GitLab CI trigger only)
MR_IID=1                                         # merge request whose pipelines are triggered
TRIGGER_INTERVAL=180                             # seconds between CI trigger cycles
